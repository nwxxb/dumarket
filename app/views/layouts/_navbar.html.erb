<div
  class="navbar bg-base-100 border-b border-base-300 flex-row"
  <%= tag.attributes(test_id("user-navbar")) %>
>
  <div class="flex-1">
    <%= link_to "dumarket", root_path, class: "btn btn-ghost text-xl" %>
  </div>
  <div class="flex gap-2">
    <%= link_to cart_items_path do %>
      <div tabindex="0" role="button" class="btn btn-ghost btn-circle">
        <div class="indicator">
          <%= icon "shopping-cart", class: ["h-6 w-6"] %>
          <!--
          <span class="badge badge-sm indicator-item">8</span>
          -->
        </div>
      </div>
    <% end %>
    <% if current_user.present? %>
      <div
        class="dropdown dropdown-end"
        <%= tag.attributes(test_id("authenticated-user-dropdown")) %>
      >
        <div tabindex="0" role="button" class="btn btn-ghost btn-circle avatar">
          <div class="w-10 rounded-full">
            <img
              alt="User Profile Photo"
              <% if current_user.avatar.present? %>
              <%= tag.attributes(src: url_for(current_user.avatar.variant(resize_to_limit: [128, 128]))) %>
              <% else %>
              <%= tag.attributes(src: image_path("simple_mountain.png")) %>
              <% end %>
            />
          </div>
        </div>
        <ul
          tabindex="-1"
          class="
            menu menu-md dropdown-content bg-base-100 rounded-box z-1 mt-3 p-2 shadow
            border-x border-b border-neutral-content/20
          "
        >
          <li class="menu-title cursor-default">
            <%= current_user.email %>
          </li>
          <li>
            <%= link_to "Profile", user_profile_path %>
          </li>
          <li>
            <%= link_to destroy_user_session_path, data: { turbo_method: :delete, } do %>
              Log out
            <% end %>
          </li>
        </ul>
      </div>
    <% else %>
      <ul class="menu menu-horizontal">
        <li><%= link_to "Sign up", new_user_registration_path %></li>
        <li><%= link_to "Log in", new_user_session_path %></li>
      </ul>
    <% end %>
  </div>
</div>
