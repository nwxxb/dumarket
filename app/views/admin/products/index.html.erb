<div class="card bg-base-100 shadow-sm grow">
  <div class="card-body">
    <h2 class="card-title">Products</h2>
    <div>
      <%= link_to "add new product", new_admin_product_path, class: "btn btn-primary" %>
    </div>

    <div class="overflow-x-auto">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Discarded At</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr class="hover:bg-base-200">
              <td><%= product.id %></td>
              <td><%= product.name %></td>
              <td><%= product.price.format %></td>
              <td><%= product.discarded_at %></td>
              <td><%= product.created_at %></td>
              <td><%= product.updated_at %></td>
              <td>
                <%= link_to admin_product_path(product), class: "btn" do %>
                  <%= icon "eye", class: "shrink-0 h-6 w-6" %>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%== if @pagy.pages > 1
        pagy_nav(
          @pagy,
          pagy_class: "custom-nav-class",
          link_extra: 'class="custom-link-class"',
        )
      end %>
      <% if @products.blank? %>
        <div class=" text-white/40 flex flex-col items-center justify-center mt-4 ">
          <%= icon "archive-box-x-mark", class: ["h-8 w-8", "mb-3"] %>
          <p class="text-base text-center sm:text-lg">
            No products found
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
