<h2 class="title">
  Create new product
</h2>

<div class="box">
  <%= form_for(@product, url: admin_products_path, html: { method: :post }) do |f| %>
    <%= render "layouts/error_messages", resource: @product %>

    <div class="field">
      <%= f.label :name, class: "label" %>
      <div class="control">
        <%= f.text_field :name, autofocus: true, class: "input" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :description, class: "label" %>
      <div class="control">
        <%= f.text_area :description, autofocus: true, class: "textarea" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :price_cents, class: "label" %>
      <div class="field has-addons">
        <div class="control">
          <%= f.number_field :price_cents, autofocus: true, min: 0, step: 10, class: "input" %>
        </div>
        <p class="control">
          <a class="button is-static">
            <%= MoneyRails.default_currency %>
          </a>
        </p>
      </div>
    </div>

    <div class="field">
      <div class="control">
        <%= f.submit "Create product", class: "button" %>
      </div>
    </div>
  <% end %>
</div>
