<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Create new product</h2>
    <%= form_for(@product, url: admin_products_path, html: { method: :post, html: "fieldset" }) do |f| %>
      <%= render "layouts/error_messages", resource: @product %>

      <%= f.label :name, class: "label" %>
      <%= f.text_field :name, autofocus: true, class: "input" %>

      <%= f.label :description, class: "label" %>
      <%= f.text_area :description, autofocus: true, class: "textarea w-full" %>

      <%= f.label :price_cents, class: "label" %>
      <%= f.label :price_cents, class: "input" do %>
        <%= f.number_field :price_cents, autofocus: true, min: 0, step: 10 %>
        <span class="bg-base-100">
          <%= MoneyRails.default_currency %>
        </span>
      <% end %>

      <div class="card-actions mt-2">
        <%= f.submit "Create product", class: "btn" %>
      </div>
    <% end %>
  </div>
</div>
