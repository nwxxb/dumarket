<h2 class="title">
  edit product: "<%= @product.name %>"
</h2>

<%= form_for(@product, url: admin_product_path(@product), html: { method: :put }) do |f| %>
  <div class="box">
    <div class="fixed-grid has-1-cols has-3-cols-desktop">
      <div class="grid">
        <div class="cell">
          <%= f.label :images, for: "product_images", data: { controller: "image-uploader"} do %>
            <%= f.file_field :images,
                         autofocus: true,
                         accept: "image/png, image/jpeg",
                         title: "click or drop image to change photo profile",
                         style: "display: none",
                         data: {
                           action: "change->image-uploader#fileOnChange",
                         } %>
            <figure class="image is-16by9">
              <img
                data-image-uploader-target="preview"
                style="object-fit: contain;"
                <% if @product.images.attached? %>
                <%= tag.attributes(src: url_for(@product.images.last)) %>
                <% else %>
                <%= tag.attributes(src: image_path("simple_mountain.png")) %>
                <% end %>
              />
            </figure>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="box">
    <%= render "layouts/error_messages", resource: @product %>

    <div class="field">
      <%= f.label :name, class: "label" %>
      <div class="control">
        <%= f.text_field :name, autofocus: true, class: "input" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :description, class: "label" %>
      <div class="control">
        <%= f.text_area :description, autofocus: true, class: "textarea" %>
      </div>
    </div>

    <div class="field">
      <%= f.label :price_cents, class: "label" %>
      <div class="field has-addons">
        <div class="control">
          <%= f.number_field :price_cents, autofocus: true, min: 0, step: 10, class: "input" %>
        </div>
        <p class="control">
          <a class="button is-static">
            <%= MoneyRails.default_currency %>
          </a>
        </p>
      </div>
    </div>

    <div class="field">
      <div class="control">
        <%= f.submit "Update product", class: "button" %>
        <%= link_to "Back", :back, class: "button" %>
      </div>
    </div>
  </div>
<% end %>
