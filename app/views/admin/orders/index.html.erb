<div class="card bg-base-100 shadow-sm grow">
  <div class="card-body">
    <h2 class="card-title">Orders</h2>
    <div class="stats shadow">
      <div class="stat" <%= tag.attributes(test_id("stat-box")) %>>
        <div class="stat-title">Total Order</div>
        <div class="stat-value"><%= @orders_count %></div>
        <div class="stat-desc">order</div>
      </div>
      <div class="stat" <%= tag.attributes(test_id("stat-box")) %>>
        <div class="stat-title">Total Revenue</div>
        <div class="stat-value"><%= @total_revenue %></div>
      </div>
      <% Order.statuses.values.each do |status| %>
        <div class="stat" <%= tag.attributes(test_id("stat-box")) %>>
          <div class="stat-title"><%= status.capitalize %></div>
          <div class="stat-value"><%= @status_grouped_count[status] %></div>
        </div>
      <% end %>
    </div>

    <div class="overflow-x-auto">
      <table class="table is-fullwidth">
        <thead>
          <tr>
            <th>Id</th>
            <th>Status</th>
            <th>Customer Name</th>
            <th>Customer Address</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr class="hover:bg-base-200">
              <td><%= order.id %></td>
              <td><%= order.status %></td>
              <td><%= order.customer_name %></td>
              <td><%= order.customer_address %></td>
              <td><%= order.created_at %></td>
              <td><%= order.updated_at %></td>
              <td>
                <%= link_to admin_order_path(order), class: "btn" do %>
                  <%= icon "eye", class: "shrink-0 h-6 w-6" %>
                  View
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @orders.blank? %>
        <div class=" text-white/40 flex flex-col items-center justify-center mt-4 ">
          <%= icon "x-mark", class: ["h-8 w-8", "mb-3"] %>
          <p class="text-base text-center sm:text-lg">
            No orders found
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
