<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
  <div class="card bg-base-100 shadow-sm md:col-span-2 h-fit">
    <div class="card-body p-3">
      <h2 class="card-title">
        Order Items
        <span
          class="badge badge-primary"
          <%= tag.attributes(test_id("order-status")) %>
        >
          <%= @order.status %>
        </span>
      </h2>
      <p>Placed on
        <%= @order.created_at %></p>
      <div class="card card-border bg-base-100 md:col-span-2 h-fit">
        <div class="card-body p-3">
          <h2 class="card-title">
            Order Items
          </h2>
          <div class="max-h-[35vh] overflow-y-scroll">
            <% @order_items.each do |order_item| %>
              <div class="flex items-center" <%= tag.attributes(test_id("order-item")) %>>
                <div class="card card-side bg-base-100 shadow-sm grow">
                  <figure class="w-15 mr-2">
                    <img
                      class="object-contain"
                      <% if order_item.images.attached? %>
                      <%= tag.attributes(src: url_for(order_item.images.last.variant(resize_to_limit: [384, 384]))) %>
                      <% else %>
                      <%= tag.attributes(src: image_path("no_image.png")) %>
                      <% end %>
                    />
                  </figure>
                  <div class="card-body p-2">
                    <p class="text-base">
                      <%= order_item.product_name %>
                      <span
                        class="text-base-content/70"
                        <%= tag.attributes(test_id("order-item-amount")) %>
                      >(Qty:
                        <%= order_item.amount %>)</span>
                    </p>
                    <p class="badge badge-primary">
                      <%= order_item.price_at_purchase.format %>
                    </p>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      </div>
      <div class="card card-border bg-base-100 md:col-span-2 h-fit">
        <div class="card-body p-3">
          <p class="card-title">
            Shipping Address
          </p>
          <p><%= @order.customer_name %></p>
          <p><%= @order.customer_address %></p>
        </div>
      </div>
    </div>
  </div>
  <div class="card bg-base-100 shadow-sm md:col-start-3 h-fit">
    <div class="card-body p-3">
      <h2 class="card-title">
        Order Summary
      </h2>
      <div class="divider"></div>
      <table class="table table-md">
        <tbody>
          <tr>
            <td>Subtotal (<%= pluralize(@order.items_count, "item") %>)</td>
            <td><%= @order.total_amount.format %></td>
          </tr>
        </tbody>
        <tfoot>
          <tr>
            <td class="text-xl">Total</td>
            <td class="text-xl" <%= tag.attributes(test_id("order-total")) %>>
              <%= @order.total_amount.format %>
            </td>
          </tr>
        </tfoot>
      </table>
      <%= form_for(@order, url: admin_order_path(@order), html: { method: :put }) do |f| %>
        <div class="fieldset">
          <%= f.label :status, "Change Status", class: "fieldset-legend" %>
          <div class="join">
            <%= f.select :status,
                     @order.unselected_statuses,
                     { include_blank: false },
                     {
                       autofocus: true,
                       class: "select join-item",
                       data: {
                         test_id: "order-update-status-options",
                       },
                     } %>
            <%= f.submit "Update",
                     class: "btn btn-primary join-item",
                     data: {
                       test_id: "order-update-status-submit",
                     } %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>
