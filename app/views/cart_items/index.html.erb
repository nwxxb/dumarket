<% if @cart_items.present? %>
  <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-5 gap-4 ">
    <div
      class="
        grid max-h-[65vh] md:max-h-[80vh] md:col-span-2 md:row-span-5 overflow-y-scroll
        gap-2 content-start
      "
    >
      <% @cart_items.each do |cart_item| %>
        <div class="flex items-center" <%= tag.attributes(test_id("cart-item-card")) %>>
          <%# <input %>
          <%#   type="checkbox" %>
          <%#   checked="checked" %>
          <%#   class="checkbox checkbox-sm sm:checkbox-lg" %>
          <%# /> %>
          <div class="card card-side bg-base-100 shadow-sm grow">
            <figure class="w-32 sm:w-40">
              <img
                class="object-contain"
                <% if cart_item.product.images.attached? %>
                <%= tag.attributes(src: url_for(cart_item.product.images.last.variant(resize_to_limit: [448, 448]))) %>
                <% else %>
                <%= tag.attributes(src: image_path("simple_mountain.png")) %>
                <% end %>
              />
            </figure>
            <div class="card-body p-2">
              <p class="card-title text-base">
                <%= cart_item.product.name %>
              </p>
              <p class="badge badge-primary">
                <%= cart_item.product.price.format %>
              </p>
              <div class="card-actions justify-end">
                <%= button_to cart_item_path(cart_item),
                method: :delete,
                class: "btn",
                data: { test_id: 'cart-item-delete' } do %>
                  <%= icon "trash", class: "shrink-0 h-4 w-4" %>
                <% end %>
                <%= form_for(cart_item, url: cart_item_path(cart_item), html: { method: :put }) do |f| %>
                  <div class="join">
                    <%= f.button :subaction,
                    value: "decrease",
                    class: "btn",
                    data: { test_id: 'cart-item-decrease-amount' } do %>
                      <%= icon "minus", class: "shrink-0 h-4 w-4" %>
                    <% end %>
                    <p
                      class="input w-fit join-item text-center"
                      <%= tag.attributes(test_id("cart-item-amount")) %>
                    >
                      <%= cart_item.amount %>
                    </p>
                    <%= f.button :subaction,
                    value: "increase",
                    class: "btn",
                    data: { test_id: 'cart-item-increase-amount' } do %>
                      <%= icon "plus", class: "shrink-0 h-4 w-4" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="card bg-base-100 shadow-sm md:row-span-2 md:col-start-3">
      <div class="card-body p-3">
        <p class="card-title">
          Cart Summary
        </p>
        <table class="table table-md">
          <tbody>
            <tr>
              <td>Subtotal (<%= pluralize(@cart_items_count, "item") %>)</td>
              <td><%= @cart_items_total_price.format %></td>
            </tr>
          </tbody>
          <tfoot>
            <tr>
              <td class="text-xl">Total</td>
              <td class="text-xl" <%= tag.attributes(test_id("cart-items-total")) %>>
                <%= @total.format %>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  </div>
<% end %>
