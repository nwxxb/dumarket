<div
  class="
    grid grid-cols-[repeat(auto-fill,minmax(150px,1fr))] gap-3 justify-items-start
  "
>
  <% if @products.present? %>
    <% @products.each do |product| %>
      <%= link_to product_path(product) do %>
        <div class="card bg-base-100 min-w-[150px] shadow-sm">
          <figure>
            <img
              class="object-cover min-w-[150px]"
              <% if product.images.attached? %>
              <%= tag.attributes(src: url_for(product.images.last.variant(resize_to_limit: [384, 384]))) %>
              <% else %>
              <%= tag.attributes(src: image_path("no_image.png")) %>
              <% end %>
            />
          </figure>
          <div class="card-body p-2">
            <h2 class="card-title text-sm mb-0 overflow-hidden text-ellipsis inline-block">
              <%= product.name %>
            </h2>
            <div class="badge badge-primary">
              <%= product.price.format %>
            </div>
          </div>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <div
      class="
        text-white/40 flex flex-col items-center justify-center min-h-[70vh]
      "
    >
      <%= icon "archive-box-x-mark", class: ["h-8 w-8", "mb-3"] %>
      <p class="text-base text-center sm:text-lg">Unfortunately, there are no products to show</p>
    </div>
  <% end %>
</div>
