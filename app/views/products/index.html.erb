<div class="grid grid-cols-[repeat(auto-fit,minmax(--spacing(64),1fr))] gap-3">
  <% @products.each do |product| %>
    <%= link_to product_path(product), class: "w-fit mx-1" do %>
      <div class="card bg-base-100 w-3xs shadow-sm">
        <img
          class="object-cover"
          <% if product.images.attached? %>
          <%= tag.attributes(src: url_for(product.images.last.variant(resize_to_limit: [448, 448]))) %>
          <% else %>
          <%= tag.attributes(src: image_path("simple_mountain.png")) %>
          <% end %>
        />
        <div class="card-body">
          <h2 class="card-title">
            <%= product.name %>
            <div class="badge badge-primary">
              <%= product.price.format %>
            </div>
          </h2>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
