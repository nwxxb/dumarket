<div class="fixed-grid has-2-cols has-4-cols-desktop">
  <div class="grid block mt-4">
    <% @products.each do |product| %>
      <div class="cell">
        <%= link_to product_path(product) do %>
          <div class="card">
            <div class="card-image">
              <figure class="image is-16by9">
                <img
                  style="object-fit: contain;"
                  <% if product.images.attached? %>
                  <%= tag.attributes(src: url_for(product.images.last)) %>
                  <% else %>
                  <%= tag.attributes(src: image_path("simple_mountain.png")) %>
                  <% end %>
                />
              </figure>
            </div>
            <div class="card-content">
              <div class="media">
                <div class="media-content">
                  <p class="title is-4"><%= product.name %></p>
                  <p class="subtitle is-6"><%= product.price.format %></p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
