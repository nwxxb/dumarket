<div class="card bg-base-200 mb-4">
  <div class="card-actions">
    <%= link_to products_path, class: "btn" do %>
      <%= icon "arrow-left", class: "shrink-0 h-6 w-6" %>
      Back
    <% end %>
  </div>
</div>
<div class="flex gap-4 flex-wrap items-start">
  <div class="card bg-base-100 shadow-sm">
    <figure>
      <img
        <% if @product.images.attached? %>
        <%= tag.attributes(src: url_for(@product.images.last.variant(resize_to_limit: [384, 384]))) %>
        <% else %>
        <%= tag.attributes(src: image_path("simple_mountain.png")) %>
        <% end %>
      />
    </figure>
  </div>
  <div class="card bg-base-100 shadow-sm grow">
    <div class="card-body">
      <h2 class="card-title text-2xl"><%= @product.name %></h2>
      <p class="text-lg text-primary"><%= @product.price.format %></p>
      <p class="text-base"><%= @product.description %></p>
      <p class="text-primary-content/30">
        last updated
        <%= time_ago_in_words(@product.created_at) %>
        ago
      </p>
    </div>
    <div class="card-actions p-3">
      <%= button_to cart_items_path,
        params: { product_id: @product.id },
        method: :post,
        class: "btn",
        data: { test_id: 'add-to-cart' } do %>
        <%= icon "shopping-cart", class: "shrink-0 h-6 w-6" %>
        Add to cart
      <% end %>
    </div>
  </div>
</div>
