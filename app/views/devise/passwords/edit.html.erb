<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Create New Password</h2>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "fieldset" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <%= f.label :password, "New Password", class: "label" %>
      <%= f.password_field :password,
                       class: "input",
                       autocomplete: "new-password",
                       placeholder: "#{@minimum_password_length} characters minimum" %>

      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation,
                       class: "input",
                       autocomplete: "new-password" %>

      <div class="card-actions">
        <%= f.submit "Change my password", class: "btn" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "devise/shared/links" %>
