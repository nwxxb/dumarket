<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Reset Your Password</h2>
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "fieldset" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, class: "input", autocomplete: "email" %>

      <div class="card-actions">
        <%= f.submit "Send me reset password instructions", class: "btn" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "devise/shared/links" %>
