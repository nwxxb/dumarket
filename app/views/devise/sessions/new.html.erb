<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Log In</h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "fieldset"}) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, class: "input", autocomplete: "email" %>

      <%= f.label :password, class: "label" %>
      <%= f.password_field :password, class: "input", autocomplete: "current-password" %>

      <% if devise_mapping.rememberable? %>
        <%= f.label :remember_me, class: "label" do %>
          <%= f.check_box :remember_me, class: "checkbox" %>
          Remember me
        <% end %>
      <% end %>

      <div class="card-actions">
        <%= f.submit "Log in", class: "btn" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "devise/shared/links" %>
