<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Sign Up</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "fieldset"}) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= f.label :email, class: "label" %>
      <%= f.email_field :email, autofocus: true, class: "input", autocomplete: "email" %>

      <%= f.label :password, class: "label" %>
      <%= f.password_field :password,
                       class: "input",
                       autocomplete: "new-password",
                       placeholder: "#{@minimum_password_length} characters minimum" %>

      <%= f.label :password_confirmation, class: "label" %>
      <%= f.password_field :password_confirmation,
                       class: "input",
                       autocomplete: "new-password" %>

      <div class="card-actions">
        <%= f.submit "Sign up", class: "btn" %>
      </div>
    <% end %>
  </div>
</div>

<%= render "devise/shared/links" %>
