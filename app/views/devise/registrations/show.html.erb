<h2 class="title">Profile</h2>

<div class="field">
  <figure class="image is-128x128">
    <img
      class="is-rounded"
      data-image-uploader-target="preview"
      style="object-fit: cover; width: 100%; height: 100%"
      <% if current_user.avatar.present? %>
      <%= tag.attributes(src: url_for(current_user.avatar.variant(resize_to_limit: [128, 128]))) %>
      <% else %>
      <%= tag.attributes(src: image_path("simple_mountain.png")) %>
      <% end %>
    />
  </figure>
</div>

<div class="field">
  <p class="label">Email</p>
  <div class="control">
    <p class="field"><%= current_user.email %></p>
  </div>
</div>

<div class="field">
  <div class="control">
    <%= link_to "edit", edit_user_registration_path, class: "button" %>
  </div>
</div>
