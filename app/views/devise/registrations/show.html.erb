<div class="card w-full bg-base-100 border-b border-base-300 shadow-sm">
  <div class="card-body">
    <h2 class="card-title">Profile</h2>
    <div class="avatar">
      <div class="w-24 rounded-xl border border-base-200">
        <img
          alt="User Profile Photo"
          <% if current_user.avatar.present? %>
          <%= tag.attributes(src: url_for(current_user.avatar.variant(resize_to_limit: [128, 128]))) %>
          <% else %>
          <%= tag.attributes(src: image_path("human_profile.png")) %>
          <% end %>
        />
      </div>
    </div>
    <p class="label">Email</p>
    <p class="input-preview"><%= current_user.email %></p>
    <div class="card-actions">
      <%= link_to "edit", edit_user_registration_path, class: "btn" %>
    </div>
  </div>
</div>
